# SERWA Professional - Shopify Integration
# Copy this file to .env and fill in your values

# Your Shopify store domain (e.g. serwa-professional.myshopify.com)
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API public token (from Shopify Admin > Apps > Headless channel)
# Get from: Settings > Apps and sales channels > Headless > Create storefront
VITE_SHOPIFY_STOREFRONT_TOKEN=your_public_storefront_api_token
